{
  "_version": "1.0.0",
  "_comment": "Archivo de configuración del sistema de extracción. Actualiza esto en GitHub para cambiar dominios, timeouts y reglas sin publicar APK.",

  "validation": {
    "min_url_length": 20,
    "max_url_length": 2000,
    "valid_schemes": ["http", "https"],
    "video_extensions": [".mp4", ".m3u8", ".webm", ".avi", ".mov"],
    "streaming_keywords": ["stream", "video", "media", "get_video", "tapepops"],
    "token_params": ["token=", "expiry=", "auth=", "key="]
  },

  "cdn_domains": {
    "dood": [
      "cloudatacdn.com",
      "ds2play.com",
      "ds2video.com",
      "doodcdn.com",
      "doodapi.com",
      "doodstream.com",
      "playmogo.com"
    ],
    "other": [
      "streamtape.com",
      "googlevideo.com",
      "youtube.com",
      "amazonaws.com",
      "cloudfront.net",
      "akamaihd.net",
      "tapecontent.net",
      "mp4upload.com",
      "mixdrop"
    ],
    "direct_match": [
      "tapepops.",
      "streamtape.",
      "get_video"
    ]
  },

  "service_detection": {
    "doodstream":  ["doodstream", "dood"],
    "streamtape":  ["streamtape"],
    "mp4upload":   ["mp4upload"],
    "mixdrop":     ["mixdrop"],
    "streamwish":  ["streamwish"],
    "filemoon":    ["filemoon"]
  },

  "hls_domains": [
    "filelions.", "lionscdn.", "kwik.", "animeflv.", "latanime.",
    "voe.sx", "voe.", "vidmoly.", "streamlare.", "vidguard.", "bembed.",
    "vtube.", "vudeo.", "awish.", "streamwish.", "filemoon.", "moonplayer.",
    "hlsvault.", "vidplay.", "megacloud.", "megaf.", "rapid-cloud.",
    "rabbitstream.", "vidstreaming.", "gogo-stream.", "embtaku.", "playtaku.",
    "alions.", "lulustream.", "luluvdo.", "streamvid.", "vidhide.",
    "vidhidepro.", "embedrise.", "ridoo.", "spdvid.", "playit.",
    "streamruby.", "strcloud.", "bestx.", "animesaga."
  ],

  "timeouts_ms": {
    "hls":        25000,
    "doodstream": 14000,
    "streamtape": 12000,
    "mp4upload":  10000,
    "default":    18000
  },

  "user_agents": {
    "ios":     "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1",
    "hls":     "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "default": "Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36"
  },

  "hls_master_pattern": "^(https?://.+/stream/[^/]+/[^/]+/\\d+/[^/]+/)([^/]+\\.m3u8)$"
}
